<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet: para carregar o app web (index.html) e falar com o Supabase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Necessárias quando o terminal se conecta por Bluetooth a um tablet separado
         (modelo "terminal externo"). Se o app rodar embarcado dentro da própria
         Moderninha Smart, essas permissões não fazem efeito, mas não atrapalham. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="false"
        android:label="Levo Maquininha"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.LevoMaquininha"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exigida pelo SDK PlugPag para algumas telas nativas de transação -->
        <activity android:name="br.com.uol.pagseguro.plugpag.PlugPagActivity"
            android:exported="false" />

    </application>

</manifest>
